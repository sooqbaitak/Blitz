# Optional customer account authentication via Supabase.
# Create a Supabase project, enable Email and Phone providers as appropriate,
# then copy the Project URL and anon/public key from Project Settings > API.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Order email notifications (Netlify Function server-side variables; do NOT prefix these with VITE_)
# Create a Resend account, verify the sender domain, and use that address below.
RESEND_API_KEY=re_your_api_key
ORDER_NOTIFICATION_FROM=BLITZ Gaming <orders@your-verified-domain.com>
